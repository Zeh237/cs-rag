# ─── RAG Engine configuration ─────────────────────────────────────────────────
# Copy this file to `.env` and adjust the values for your environment.
# All variables are optional; sensible defaults are shown in the comments.

# Elasticsearch connection
ES_HOST=http://localhost:9200
# Set both to empty strings to connect without authentication (local dev).
ES_USER=elastic
ES_PASSWORD=password

# Name of the Elasticsearch index that stores the chunked notes.
INDEX_NAME=csc_notes

# Libraries on disk (paths are relative to the project root).
# LIBRARY_DIR  -> uploaded papers (legacy ingest target).
# NOTES_DIR    -> the live, searchable notes library fetched by scripts/fetch_notes.py
#                 and indexed by scripts/index_library.py.
LIBRARY_DIR=./csc_library
NOTES_DIR=./csc_notes

# Local LLM (OpenAI-compatible /chat/completions API, e.g. LM Studio, Ollama).
# Set both to empty strings to run without a local LLM.
LLM_API_BASE=http://localhost:1234/v1
LLM_MODEL=qwen/qwen3-1.7b

# Sentence-Transformer model used to embed chunks and queries.
# The dense_vector mapping in app/services/elasticsearch.py must match its dims
# (bge-small-en-v1.5 => 384).
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Redis (conversation memory for chat history).
REDIS_HOST=redis://localhost:6379/
REDIS_PASSWORD=

# Auth signing key. CHANGE THIS in production.
SECRET_KEY=change-me-in-production

# Database (SQLAlchemy async URL).
DATABASE_URL=sqlite+aiosqlite:///./rag.db